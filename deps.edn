{:paths ["src"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.5"}
  ring/ring-jetty-adapter {:mvn/version "1.15.6"}
  metosin/reitit-ring {:mvn/version "0.11.0"}
  com.stuartsierra/component {:mvn/version "1.2.0"}}

 :aliases
 {:dev
  {:extra-paths ["dev" "test"]
   :extra-deps
   {org.clojure/tools.namespace {:mvn/version "1.5.1"}
    ring/ring-mock {:mvn/version "0.6.2"}}}

  :test
  {:extra-paths ["test"]
   :extra-deps
   {ring/ring-mock {:mvn/version "0.6.2"}
    io.github.cognitect-labs/test-runner
    {:git/tag "v0.5.1"
     :git/sha "dfb30dd"}}
   :exec-fn cognitect.test-runner.api/test}

  :perf
  {:extra-deps
   {org.clojure/data.json {:mvn/version "2.5.1"}}}}}
